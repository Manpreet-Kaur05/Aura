<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom styles by Manpreet - October 2025 -->
    
    <!-- Button Styles -->
    <style name="PrimaryButtonStyle">
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">16dp</item>
        <item name="backgroundTint">#2196F3</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
    
    <style name="SecondaryButtonStyle">
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">16dp</item>
        <item name="strokeColor">#2196F3</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textColor">#2196F3</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    
    <!-- Card Styles -->
    <style name="DashboardCardStyle">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@android:color/white</item>
    </style>
    
    <style name="MoodCardStyle" parent="DashboardCardStyle">
        <item name="cardElevation">2dp</item>
    </style>
    
    <!-- Text Styles -->
    <style name="HeaderTextStyle">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="BodyTextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#212121</item>
    </style>
    
    <style name="CaptionTextStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#757575</item>
    </style>
    
    <!-- Mood Button Style -->
    <style name="MoodButtonStyle">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
