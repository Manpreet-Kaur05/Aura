<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDE7"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Gratitude Journal"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#F57C00"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="List 3 things you're grateful for today:"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/gratitude1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1. I'm grateful for..."
            android:padding="16dp"
            android:background="@android:color/white"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/gratitude2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2. I appreciate..."
            android:padding="16dp"
            android:background="@android:color/white"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/gratitude3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="3. I'm thankful for..."
            android:padding="16dp"
            android:background="@android:color/white"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/saveGratitudeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Gratitude 🌟"
            android:textSize="18sp"
            android:padding="16dp"
            android:backgroundTint="#F57C00"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
